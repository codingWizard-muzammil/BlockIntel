// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Users {
  walletAddress String     @unique
  verifyToken   String
  chain         String
  projects      projects[]

  @@map("users")
}

model projects {
  id           String   @id @default(uuid())
  name         String
  description  String?
  chain        String
  purpose      String
  ownerAddress String
  createdAt    DateTime @default(now())

  owner     Users       @relation(fields: [ownerAddress], references: [walletAddress])
  contracts contracts[]

  @@map("projects")
}

model contracts {
  id              String    @id @default(uuid())
  address         String?   @unique
  name            String    @db.VarChar(150)
  projectId       String
  ownerAddress    String
  language        String
  source          String    @default("") @db.Text
  createdAt       DateTime  @default(now())

  // Cached result of the last successful compile, so the ABI/bytecode can be
  // reused (e.g. by the playground's call endpoint) without recompiling from
  // source on every request.
  abi             Json?
  bytecode        String?   @db.Text
  compilerVersion String?
  gasEstimate     String?
  compiledAt      DateTime?

  // Cached result of the last AI analysis (summary/attacks/improvements),
  // so the analyzer views don't re-prompt the model on every page visit.
  analysis   Json?
  analyzedAt DateTime?

  project projects @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("contracts")
}
